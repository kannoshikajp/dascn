# ========================================================
# Joppe Backend Environment Configuration Template
# Copy this file to .env and adjust values for your machine
# ========================================================

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/joppe_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT Security Configuration
JWT_SECRET=joppe-super-secret-jwt-key-with-minimum-256-bits-length-required-by-hmac-sha256
JWT_EXPIRATION_SECONDS=86400

# Server Port (optional, default: 8080)
# SERVER_PORT=8080

# Domain & Server Base URL Configuration
APP_DOMAIN=joppe.penguinlab.org
APP_BASE_URL=https://joppe.penguinlab.org
APP_FRONTEND_URL=https://joppe-dash.vercel.app

# CORS Allowed Origins & Patterns (comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:8888,http://localhost:3000,http://127.0.0.1:8888,http://127.0.0.1:3000,https://joppe-dash.vercel.app,https://joppe-dashboard.vercel.app,https://joppe.penguinlab.org
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://*.vercel.app,https://*.penguinlab.org

# Default Admin Account (auto-created on startup if not exists)
APP_ADMIN_AUTO_CREATE=true
APP_ADMIN_EMAIL=admin@joppe.vn
APP_ADMIN_PASSWORD=Admin@123456
APP_ADMIN_FULL_NAME=System Administrator

# ========================================================
# Mail Configuration (SMTP)
# Local MailHog: host=localhost, port=1025, auth=false, starttls=false (Web UI: http://localhost:8025)
# Production/Cloud (Gmail/SendGrid/Mailtrap): port=587, auth=true, starttls=true
# ========================================================
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS_ENABLE=false
APP_MAIL_FROM=noreply@joppe.vn
APP_MAIL_FROM_NAME=Joppe Tech Store

